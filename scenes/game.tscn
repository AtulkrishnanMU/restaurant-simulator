[sub_resource type="GDScript" id="GDScript_p57ef"]
script/source = "extends Node2D

func _on_ready() -> void:
	print(\"GAME BEGAN\")
	Input.set_mouse_mode(Input.MOUSE_MODE_VISIBLE)
	var tex := load(\"res://assets/sprites/objects/cursor.png\") as Texture2D
	if tex:
		var img := tex.get_image()
		# Resize to a smaller, usable size (adjust as you like)
		img.resize(20, 20, Image.INTERPOLATE_NEAREST)
		var small_tex := ImageTexture.create_from_image(img)
		# Use the top-left as hotspot so clicks line up with the tip
		Input.set_custom_mouse_cursor(small_tex, Input.CURSOR_ARROW, Vector2.ZERO)
	# Wire Shop button
	var btn := get_node_or_null(\"UI/ShopButton\")
	var menu := get_node_or_null(\"UI/ShopMenu\")
	if btn and menu:
		btn.pressed.connect(func():
			menu.visible = true
		)
"

